//go:build paired854

// paired_854_test.go — #854 binding paired arm (ABAB against main 525b4ddf).
//
// The SAME file compiles on main and on the branch (it uses no #854 symbol), so
// each run measures the code under test with an identical workload:
//
//   - one 50K-object LIST content cell (objects ~1.4 KB, like run 12's 71 MB
//     cell), on a real informer over a fake apiserver;
//   - D=20 dependent RESTActions modelled as refresher re-resolves: every object
//     event dirty-marks all 20 (a coalescing set, as the refresher's workqueue
//     dedups), and 4 workers (defaultRefresherParallelism) each dequeue one,
//     read the cell through the production reader (apistageContentServe, a
//     refresher ctx triggered by the cell's GVR) and run a dashboard-style jq
//     filter over the 50K items, using `now`;
//   - object events at PAIRED854_RATE per second for PAIRED854_SECONDS;
//   - CUSTOMERS, concurrently (customer ctx, closed loop, PAIRED854_THINK_MS
//     between requests): PAIRED854_CUST_HEAVY readers of the dependents' list
//     (the 50K cell + the same jq — a customer resolving a dependent), and
//     PAIRED854_CUST_LIGHT readers of an UNRELATED widget (a 200-object list in
//     another namespace that no event touches + the same jq).
//
// dirty_to_fresh is the refresher's own window, on the harness's model of it
// (the coalescing set + 4 workers = defaultRefresherParallelism): from the mark
// that made a dependent dirty to the completion of the re-resolve that dequeued
// it; a mark landing while that re-resolve runs opens the next window. The
// model keeps the refresher's customer-priority yield (refresher.go
// yieldToCustomer, Ship #98): a customer request holds an in-flight count for
// its duration (the dispatchers' ServeHTTP bracket), and a worker, after its
// dequeue and before the re-resolve, parks while that count is non-zero —
// re-checked every 25 ms, at most 5 s (refresherYieldPoll /
// refresherYieldMaxParked). A re-resolve already running is not interrupted.
//
// Reported (JSON to PAIRED854_OUT): process CPU, TotalAlloc and peak HeapInuse
// over the window, content fills, dependent completions, events applied. A CPU
// profile (PAIRED854_PROF) carries pprof labels: the fill path's own
// apistage_fill_* labels, and dep=<name> on each dependent's whole re-resolve,
// so the dependents' remaining cost is measured, not inferred.
package api

import (
	"context"
	"encoding/json"
	"fmt"
	"math"
	"net/http"
	"os"
	"runtime"
	"runtime/pprof"
	"sort"
	"strconv"
	"sync"
	"sync/atomic"
	"syscall"
	"testing"
	"time"

	httpcall "github.com/krateo-platformops/plumbing/http/request"
	"github.com/krateo-platformops/snowplow/internal/cache"
	jqsupport "github.com/krateo-platformops/snowplow/internal/support/jq"
	rbacv1 "k8s.io/api/rbac/v1"
	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
	"k8s.io/apimachinery/pkg/apis/meta/v1/unstructured"
	k8sruntime "k8s.io/apimachinery/pkg/runtime"
	"k8s.io/apimachinery/pkg/runtime/schema"
	dynamicfake "k8s.io/client-go/dynamic/fake"
	"k8s.io/utils/ptr"
)

const pairedDependents = 20

const pairedFilter = `[.items[] | {uid: .metadata.uid, name: .metadata.name, namespace: .metadata.namespace,
  created: .metadata.creationTimestamp, kind: .kind, apiVersion: .apiVersion,
  ready: (((.status.conditions // []) | map(select(.type == "Ready")) | first) // {} | .status),
  age: (now - (.metadata.creationTimestamp | fromdateiso8601))}] | length`

func pairedEnvInt(k string, def int) int {
	if v, err := strconv.Atoi(os.Getenv(k)); err == nil && v > 0 {
		return v
	}
	return def
}

func pairedObj(i, gen int) *unstructured.Unstructured {
	pad := make([]byte, 700)
	for j := range pad {
		pad[j] = 'a' + byte((i+j)%26)
	}
	return &unstructured.Unstructured{Object: map[string]any{
		"apiVersion": "composition.krateo.io/v1",
		"kind":       "FullStackApp",
		"metadata": map[string]any{
			"namespace": r1Ns, "name": fmt.Sprintf("fsa-%06d", i), "uid": fmt.Sprintf("uid-%06d", i),
			"creationTimestamp": "2026-10-23T00:00:00Z",
			"labels":            map[string]any{"krateo.io/composition-id": strconv.Itoa(i), "env": []string{"prod", "dev"}[i%2]},
			"annotations":       map[string]any{"krateo.io/pad": string(pad)},
		},
		"spec": map[string]any{"gen": int64(gen), "values": map[string]any{"replicas": int64(i % 3), "image": "ghcr.io/krateo/app:1.0"}},
		"status": map[string]any{"conditions": []any{
			map[string]any{"type": "Ready", "status": []string{"True", "False"}[gen%2], "reason": "Available", "lastTransitionTime": "2026-10-23T00:00:00Z"},
			map[string]any{"type": "Synced", "status": "True", "reason": "ReconcileSuccess"},
		}},
	}}
}

const pairedOtherNs = "paired-other"

// pairedQuantiles returns p50/p95/p99 (ms) of xs.
func pairedQuantiles(xs []time.Duration) map[string]float64 {
	if len(xs) == 0 {
		return map[string]float64{"n": 0}
	}
	s := append([]time.Duration(nil), xs...)
	sort.Slice(s, func(i, j int) bool { return s[i] < s[j] })
	q := func(p float64) float64 {
		i := int(math.Ceil(p*float64(len(s)))) - 1
		return float64(s[max(i, 0)].Microseconds()) / 1000
	}
	return map[string]float64{"n": float64(len(s)), "p50_ms": q(0.50), "p95_ms": q(0.95), "p99_ms": q(0.99), "max_ms": float64(s[len(s)-1].Microseconds()) / 1000}
}

// pairedLat collects latencies under a mutex.
type pairedLat struct {
	mu sync.Mutex
	xs []time.Duration
}

func (l *pairedLat) add(d time.Duration) { l.mu.Lock(); l.xs = append(l.xs, d); l.mu.Unlock() }
func (l *pairedLat) get() []time.Duration {
	l.mu.Lock()
	defer l.mu.Unlock()
	return append([]time.Duration(nil), l.xs...)
}

func pairedCPU() time.Duration {
	var ru syscall.Rusage
	_ = syscall.Getrusage(syscall.RUSAGE_SELF, &ru)
	return time.Duration(ru.Utime.Nano() + ru.Stime.Nano())
}

func TestPaired854(t *testing.T) {
	n := pairedEnvInt("PAIRED854_N", 50000)
	rate := pairedEnvInt("PAIRED854_RATE", 1)
	secs := pairedEnvInt("PAIRED854_SECONDS", 30)
	t.Setenv("CACHE_ENABLED", "true")
	t.Setenv("RESOLVED_CACHE_ENABLED", "true")
	cache.ResetResolvedCacheForTest()
	cache.ResetDepsForTest()

	seed := []k8sruntime.Object{
		&rbacv1.ClusterRole{ObjectMeta: metav1.ObjectMeta{Name: "paired-reader"},
			Rules: []rbacv1.PolicyRule{{APIGroups: []string{"composition.krateo.io"}, Resources: []string{"fullstackapps"}, Verbs: []string{"get", "list"}}}},
		&rbacv1.RoleBinding{ObjectMeta: metav1.ObjectMeta{Namespace: r1Ns, Name: "paired-binding"},
			Subjects: []rbacv1.Subject{{Kind: rbacv1.UserKind, APIGroup: "rbac.authorization.k8s.io", Name: r1User}},
			RoleRef:  rbacv1.RoleRef{APIGroup: "rbac.authorization.k8s.io", Kind: "ClusterRole", Name: "paired-reader"}},
		&rbacv1.RoleBinding{ObjectMeta: metav1.ObjectMeta{Namespace: pairedOtherNs, Name: "paired-binding"},
			Subjects: []rbacv1.Subject{{Kind: rbacv1.UserKind, APIGroup: "rbac.authorization.k8s.io", Name: r1User}},
			RoleRef:  rbacv1.RoleRef{APIGroup: "rbac.authorization.k8s.io", Kind: "ClusterRole", Name: "paired-reader"}},
	}
	for i := 0; i < n; i++ {
		seed = append(seed, pairedObj(i, 0))
	}
	for i := 0; i < 200; i++ {
		o := pairedObj(i, 0)
		o.SetNamespace(pairedOtherNs)
		seed = append(seed, o)
	}
	scheme := k8sruntime.NewScheme()
	_ = rbacv1.AddToScheme(scheme)
	listKinds := map[schema.GroupVersionResource]string{
		r1FsaGVR: "FullStackAppList",
		{Group: "rbac.authorization.k8s.io", Version: "v1", Resource: "roles"}:               "RoleList",
		{Group: "rbac.authorization.k8s.io", Version: "v1", Resource: "rolebindings"}:        "RoleBindingList",
		{Group: "rbac.authorization.k8s.io", Version: "v1", Resource: "clusterroles"}:        "ClusterRoleList",
		{Group: "rbac.authorization.k8s.io", Version: "v1", Resource: "clusterrolebindings"}: "ClusterRoleBindingList",
	}
	dyn := dynamicfake.NewSimpleDynamicClientWithCustomListKinds(scheme, listKinds, seed...)
	seed = nil
	rw, err := cache.NewResourceWatcher(context.Background(), dyn)
	if err != nil {
		t.Fatal(err)
	}
	defer rw.Stop()
	_, syncCh := rw.EnsureResourceType(r1FsaGVR)
	select {
	case <-syncCh:
	case <-time.After(5 * time.Minute):
		t.Fatal("informer did not sync")
	}
	ctx0, cancel0 := context.WithTimeout(context.Background(), 5*time.Minute)
	if err := rw.WaitForCacheSync(ctx0, 5*time.Minute); err != nil {
		t.Fatal(err)
	}
	cancel0()
	waitOwnRBACPublish(t, rw)
	cache.SetGlobal(rw)
	defer cache.SetGlobal(nil)
	for !rw.IsServable(r1FsaGVR) {
		time.Sleep(10 * time.Millisecond)
	}
	store := cache.ResolvedCache()
	call := httpcall.RequestOptions{RequestInfo: httpcall.RequestInfo{
		Path: "/apis/composition.krateo.io/v1/namespaces/" + r1Ns + "/fullstackapps", Verb: ptr.To(http.MethodGet)}}
	// Prime: one customer read fills the cell (and anchors it on the branch).
	if _, served, ok, _ := apistageContentServe(r1Ctx(), store, call, false); !ok || !served {
		t.Fatal("prime read not served")
	}
	otherCall := httpcall.RequestOptions{RequestInfo: httpcall.RequestInfo{
		Path: "/apis/composition.krateo.io/v1/namespaces/" + pairedOtherNs + "/fullstackapps", Verb: ptr.To(http.MethodGet)}}
	if _, served, ok, _ := apistageContentServe(r1Ctx(), store, otherCall, false); !ok || !served {
		t.Fatal("prime read of the unrelated list not served")
	}
	runtime.GC()

	var inWindow atomic.Bool
	var custInFlight, parkedNS, yieldCapped atomic.Int64
	yield := func() {
		return // NO-YIELD VARIANT
		if custInFlight.Load() == 0 {
			return
		}
		t0 := time.Now()
		defer func() { parkedNS.Add(int64(time.Since(t0))) }()
		for custInFlight.Load() > 0 {
			if time.Since(t0) >= 5*time.Second {
				yieldCapped.Add(1)
				return
			}
			time.Sleep(25 * time.Millisecond)
		}
	}
	// Dependents: a coalescing dirty set + 4 workers.
	var mu sync.Mutex
	dirty := map[int]time.Time{} // dependent → the mark that opened its window
	var d2f pairedLat
	wake := make(chan struct{}, 1)
	stop := make(chan struct{})
	var completions, jqErrs atomic.Int64
	var wg sync.WaitGroup
	for w := 0; w < 4; w++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			for {
				mu.Lock()
				d := -1
				var markedAt time.Time
				for k, at := range dirty {
					d, markedAt = k, at
					break
				}
				if d >= 0 {
					delete(dirty, d)
				}
				mu.Unlock()
				if d < 0 {
					select {
					case <-stop:
						return
					case <-wake:
					case <-time.After(5 * time.Millisecond):
					}
					continue
				}
				yield()
				labels := pprof.Labels("dep", fmt.Sprintf("dep-%02d", d))
				pprof.Do(context.Background(), labels, func(lctx context.Context) {
					rctx := cache.WithRefreshTriggerGVR(cache.WithBackgroundResolve(r1Ctx()), r1FsaGVR)
					v, served, ok, _ := apistageContentServe(rctx, store, call, false)
					if !ok || !served {
						jqErrs.Add(1)
						return
					}
					if _, _, err := EvalValue(lctx, pairedFilter, v, jqsupport.ModuleLoader()); err != nil {
						jqErrs.Add(1)
					}
					completions.Add(1)
					if inWindow.Load() {
						d2f.add(time.Since(markedAt))
					}
				})
			}
		}()
	}

	// Measurement window.
	var prof *os.File
	if p := os.Getenv("PAIRED854_PROF"); p != "" {
		prof, _ = os.Create(p)
		_ = pprof.StartCPUProfile(prof)
	}
	var peak atomic.Uint64
	sampStop := make(chan struct{})
	go func() {
		tk := time.NewTicker(50 * time.Millisecond)
		defer tk.Stop()
		var ms runtime.MemStats
		for {
			select {
			case <-sampStop:
				return
			case <-tk.C:
				runtime.ReadMemStats(&ms)
				for {
					cur := peak.Load()
					if ms.HeapInuse <= cur || peak.CompareAndSwap(cur, ms.HeapInuse) {
						break
					}
				}
			}
		}
	}()
	// Customers.
	heavyN := pairedEnvInt("PAIRED854_CUST_HEAVY", 2)
	lightN := pairedEnvInt("PAIRED854_CUST_LIGHT", 4)
	think := time.Duration(pairedEnvInt("PAIRED854_THINK_MS", 50)) * time.Millisecond
	var heavyLat, lightLat pairedLat
	var custErrs atomic.Int64
	custStop := make(chan struct{})
	var custWG sync.WaitGroup
	customer := func(class string, c httpcall.RequestOptions, lat *pairedLat) {
		defer custWG.Done()
		for {
			select {
			case <-custStop:
				return
			case <-time.After(think):
			}
			t0 := time.Now()
			custInFlight.Add(1)
			pprof.Do(context.Background(), pprof.Labels("cust", class), func(lctx context.Context) {
				v, served, ok, _ := apistageContentServe(r1Ctx(), store, c, false)
				if !ok || !served {
					custErrs.Add(1)
					return
				}
				if _, _, err := EvalValue(lctx, pairedFilter, v, jqsupport.ModuleLoader()); err != nil {
					custErrs.Add(1)
				}
			})
			custInFlight.Add(-1)
			if inWindow.Load() {
				lat.add(time.Since(t0))
			}
		}
	}
	for i := 0; i < heavyN; i++ {
		custWG.Add(1)
		go customer("heavy", call, &heavyLat)
	}
	for i := 0; i < lightN; i++ {
		custWG.Add(1)
		go customer("light", otherCall, &lightLat)
	}

	var ms0, ms1 runtime.MemStats
	runtime.ReadMemStats(&ms0)
	inWindow.Store(true)
	fills0 := ContentFillStatsSnapshot().Total
	cpu0, t0 := pairedCPU(), time.Now()

	res := dyn.Resource(r1FsaGVR).Namespace(r1Ns)
	events := 0
	tick := time.NewTicker(time.Second / time.Duration(rate))
	end := time.After(time.Duration(secs) * time.Second)
loop:
	for {
		select {
		case <-end:
			break loop
		case <-tick.C:
			i := (events * 7919) % n
			if _, err := res.Update(context.Background(), pairedObj(i, events+1), metav1.UpdateOptions{}); err != nil {
				t.Fatal(err)
			}
			events++
			mu.Lock()
			now := time.Now()
			for d := 0; d < pairedDependents; d++ {
				if _, open := dirty[d]; !open {
					dirty[d] = now
				}
			}
			mu.Unlock()
			select {
			case wake <- struct{}{}:
			default:
			}
		}
	}
	tick.Stop()
	inWindow.Store(false)
	wall := time.Since(t0)
	cpu1 := pairedCPU()
	runtime.ReadMemStats(&ms1)
	fills1 := ContentFillStatsSnapshot().Total
	close(sampStop)
	if prof != nil {
		pprof.StopCPUProfile()
		_ = prof.Close()
	}
	close(stop)
	close(custStop)
	wg.Wait()
	custWG.Wait()
	heavy, light := heavyLat.get(), lightLat.get()

	var fills uint64
	fillReasons := map[string]uint64{}
	for k, v := range fills1 {
		fills += v - fills0[k]
		fillReasons[k] = v - fills0[k]
	}
	out := map[string]any{
		"n": n, "rate": rate, "seconds": secs, "events": events,
		"wall_s":           wall.Seconds(),
		"cpu_s":            (cpu1 - cpu0).Seconds(),
		"cpu_cores":        (cpu1 - cpu0).Seconds() / wall.Seconds(),
		"alloc_bytes":      ms1.TotalAlloc - ms0.TotalAlloc,
		"alloc_per_event":  float64(ms1.TotalAlloc-ms0.TotalAlloc) / float64(max(events, 1)),
		"peak_heap_inuse":  peak.Load(),
		"heap_inuse_base":  ms0.HeapInuse,
		"fills":            fills,
		"fill_reasons":     fillReasons,
		"completions":      completions.Load(),
		"completions_s":    float64(completions.Load()) / wall.Seconds(),
		"dependent_errors": jqErrs.Load(),
		"num_gc":           ms1.NumGC - ms0.NumGC,
		"gc_pause_s":       float64(ms1.PauseTotalNs-ms0.PauseTotalNs) / 1e9,
		"gomaxprocs":       runtime.GOMAXPROCS(0),
		"dirty_to_fresh":   pairedQuantiles(d2f.get()),
		"cust_heavy":       pairedQuantiles(heavy),
		"cust_light":       pairedQuantiles(light),
		"cust_heavy_rps":   float64(len(heavy)) / wall.Seconds(),
		"cust_light_rps":   float64(len(light)) / wall.Seconds(),
		"cust_errors":      custErrs.Load(),
		"cust_heavy_n":     heavyN,
		"cust_light_n":     lightN,
		"cust_think_ms":    think.Milliseconds(),
		"yield_parked_s":   float64(parkedNS.Load()) / 1e9,
		"yield_capped":     yieldCapped.Load(),
	}
	if st := pairedListStats(); st != nil {
		out["list_incremental"] = st
	}
	b, _ := json.MarshalIndent(out, "", "  ")
	if p := os.Getenv("PAIRED854_OUT"); p != "" {
		_ = os.WriteFile(p, b, 0o644)
	}
	t.Logf("%s", b)
}
