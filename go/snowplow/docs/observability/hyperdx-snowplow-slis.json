      "config": {
        "displayType": "line",
        "sourceId": "6a8c6a42b001b331cb401a6e",
        "where": "ServiceName = 'snowplow'",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "where": "ServiceName = 'snowplow' AND positionCaseInsensitive(Body, '\"level\":\"ERROR\"') > 0",
