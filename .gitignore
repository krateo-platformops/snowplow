## VSCode
.vscode/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
*.dat
*.DS_Store
**/bin/**

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Goreleaser builds
**/dist/**

# This is my wip ideas folder
experiments/**

# Dotenv files
.env
**/*.env

# Secrets files
**/password.txt
**/token.txt
**/*.crt
**/*.key

# Compiled auditor binary (go build output, not an artifact we ship)
/go/snowplow/checkidentitykeys

# Built tool binaries: a `go build` run in go/snowplow/scripts/<tool>/ leaves an
# extensionless executable beside the tool's source (#912 committed one). Ignore
# every file without a source extension directly in a tool directory; the
# check_no_tracked_binaries.sh gate refuses one that is added anyway.
/go/snowplow/scripts/*/*
!/go/snowplow/scripts/*/*.*
!/go/snowplow/scripts/*/*/
