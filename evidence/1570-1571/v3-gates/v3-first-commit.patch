diff --git a/go/snowplow/internal/cache/refresher_floor_deferral.go b/go/snowplow/internal/cache/refresher_floor_deferral.go
new file mode 100644
index 00000000..2b233953
--- /dev/null
+++ b/go/snowplow/internal/cache/refresher_floor_deferral.go
@@ -0,0 +1,189 @@
+// refresher_floor_deferral.go — #1570: a floored key's wait follows the LIVE
+// backlog of its side, not the backlog it saw when it was floored.
+//
+// THE LATCH THIS CLOSES. The floor is RefreshCost × max(1, K/S) (rateFloor). Read
+// once at the floored dequeue and handed to the delaying queue as a fixed
+// AddAfter, it froze K at that moment: a cell floored at a burst's peak kept the
+// peak's wait after the burst drained. At the refresher's recorded burst scale
+// (~1,669 keys, S = 3) a 275 ms cell dequeued at the peak would have held its
+// last change for ~153 s, against main's fixed 2 s.
+//
+// THE RULE. The side owns its floored keys in one set. Each key's due time is
+// recomputed from the side's CURRENT backlog:
+//
+//	due = CreatedAt + RefreshCost × max(1, K_now/S)
+//
+// and the set is re-evaluated whenever K can have fallen below the K it was last
+// evaluated with — the end of a key's work on that side (endViewed /
+// endUnviewed) — and at its soonest due time by ONE timer per side. A key whose
+// due time has passed goes back to its tier queue (q.Add); its re-dequeue reads
+// the live entry and the live K again, exactly as any dequeue does. No cap and
+// no TTL: the wait is the cell's own cost times the backlog it actually waits
+// behind, at every moment.
+//
+// WHY A SCAN ONLY WHEN K FELL. Every due time grows with K. The timer is armed
+// at the soonest due time computed with kScan; while K ≥ kScan no key can be
+// due before it, so only a K below kScan (or the timer itself, or a new key)
+// needs a scan. A K that rose makes the timer fire early: the scan finds nothing
+// due and re-arms it later. Work is O(floored keys) per scan, a multiply and a
+// compare each.
+//
+// LOSSLESS, as the AddAfter was: a key leaves the set only through q.Add (the
+// idempotent base Add, which a re-mark meanwhile may already have done), and the
+// timer is armed whenever the set is not empty. The trigger GVRs and the dirty
+// window stay with the key through the deferral (processNext consumes them only
+// past the floor).
+package cache
+
+import (
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"k8s.io/client-go/util/workqueue"
+)
+
+// floorDeferred is one floored key: the queue it returns to and the entry
+// fields its floor is computed from, as the floored dequeue read them. Its
+// re-dequeue reads the live entry; these only time the release.
+type floorDeferred struct {
+	q         workqueue.TypedRateLimitingInterface[string]
+	createdAt time.Time     // the entry's CreatedAt, on the store clock
+	cost      time.Duration // the entry's RefreshCost
+}
+
+// floorDeferral is one side's floored keys (viewed, or unviewed: normal plus
+// cluster_list, the sides backlogShare reads).
+type floorDeferral struct {
+	r    *refresher
+	tier refreshTier // the side backlogShare reads: tierViewed or tierNormal
+
+	mu      sync.Mutex
+	keys    map[string]floorDeferred
+	kScan   int // the K the armed timer's due time was computed with
+	timer   *time.Timer
+	stopped bool
+
+	n atomic.Int64 // len(keys): the completion hook's lock-free "anything floored?"
+}
+
+func newFloorDeferral(r *refresher, tier refreshTier) *floorDeferral {
+	return &floorDeferral{r: r, tier: tier, keys: map[string]floorDeferred{}}
+}
+
+// floorFor is the floor of a cell whose last refresh cost cost, on a side
+// serving k keys with s workers (rateFloor's rule; the test-only override wins).
+func floorFor(cost time.Duration, k, s int) time.Duration {
+	if d := refresherFloorOverride.Load(); d != nil {
+		return *d
+	}
+	if cost <= 0 {
+		return 0
+	}
+	if k <= s {
+		return cost
+	}
+	return time.Duration(int64(cost) * int64(k) / int64(s))
+}
+
+// add takes a floored key into the set (a key already in it is re-timed from
+// the entry this dequeue read) and re-evaluates.
+func (d *floorDeferral) add(key string, q workqueue.TypedRateLimitingInterface[string], createdAt time.Time, cost time.Duration) {
+	d.mu.Lock()
+	if d.stopped {
+		d.mu.Unlock()
+		return
+	}
+	d.keys[key] = floorDeferred{q: q, createdAt: createdAt, cost: cost}
+	d.n.Store(int64(len(d.keys)))
+	d.mu.Unlock()
+	d.evaluate(true)
+}
+
+// backlogFell is the end of a key's work on this side: K may now be below the
+// K the timer was armed with.
+func (d *floorDeferral) backlogFell() {
+	if d == nil || d.n.Load() == 0 {
+		return
+	}
+	d.evaluate(false)
+}
+
+// evaluate releases every key whose due time, at the side's current K, has
+// passed, and arms the timer at the soonest remaining one. force scans whatever
+// K is (a new key, the timer); otherwise only a K below kScan can make a key
+// due before the armed timer.
+func (d *floorDeferral) evaluate(force bool) {
+	k, s := d.r.backlogShare(d.tier) // priorityGetMu, never taken under d.mu
+	c := ResolvedCache()
+	d.mu.Lock()
+	if d.stopped || len(d.keys) == 0 || (!force && k >= d.kScan) {
+		d.mu.Unlock()
+		return
+	}
+	var now time.Time
+	if c != nil {
+		now = c.now() // the store clock CreatedAt was stamped on (#930)
+	}
+	var release []string
+	var queues []workqueue.TypedRateLimitingInterface[string]
+	var soonest time.Time
+	for key, e := range d.keys {
+		due := e.createdAt.Add(floorFor(e.cost, k, s))
+		if c == nil || !due.After(now) {
+			release = append(release, key)
+			queues = append(queues, e.q)
+			delete(d.keys, key)
+			continue
+		}
+		if soonest.IsZero() || due.Before(soonest) {
+			soonest = due
+		}
+	}
+	d.kScan = k
+	d.n.Store(int64(len(d.keys)))
+	if len(d.keys) == 0 {
+		if d.timer != nil {
+			d.timer.Stop()
+		}
+	} else if wait := soonest.Sub(now); d.timer == nil {
+		d.timer = time.AfterFunc(wait, func() { d.evaluate(true) })
+	} else {
+		d.timer.Reset(wait)
+	}
+	d.mu.Unlock()
+	for i, key := range release {
+		queues[i].Add(key)
+	}
+}
+
+// stop ends the set with its queues: the timer is stopped and nothing is
+// released any more (the queues are shut down; an Add would be dropped anyway).
+func (d *floorDeferral) stop() {
+	d.mu.Lock()
+	d.stopped = true
+	if d.timer != nil {
+		d.timer.Stop()
+	}
+	d.keys = map[string]floorDeferred{}
+	d.n.Store(0)
+	d.mu.Unlock()
+}
+
+// floorDeferralFor is the set of the side that serves tier.
+func (r *refresher) floorDeferralFor(tier refreshTier) *floorDeferral {
+	if tier == tierViewed {
+		return r.viewedDeferral
+	}
+	return r.unviewedDeferral
+}
+
+// stopFloorDeferrals stops both sides' sets.
+func (r *refresher) stopFloorDeferrals() {
+	if r.viewedDeferral != nil {
+		r.viewedDeferral.stop()
+	}
+	if r.unviewedDeferral != nil {
+		r.unviewedDeferral.stop()
+	}
+}
diff --git a/go/snowplow/internal/cache/refresher_floor_live_backlog_1570_test.go b/go/snowplow/internal/cache/refresher_floor_live_backlog_1570_test.go
new file mode 100644
index 00000000..a4d1ba61
--- /dev/null
+++ b/go/snowplow/internal/cache/refresher_floor_live_backlog_1570_test.go
@@ -0,0 +1,179 @@
+// refresher_floor_live_backlog_1570_test.go — #1570: a floored key's wait
+// follows its side's LIVE backlog (refresher_floor_deferral.go), never the
+// backlog it saw when it was floored.
+//
+// Both arms drive the real refresher (StartRefresher, the real dequeue, the real
+// floored branch, the real terminal Put) under the production floor rule. A
+// measured cell X is dequeued at the top of a backlog of fillers — floored at
+// RefreshCost × K/S with K the whole backlog — and the fillers then drain.
+//
+//  1. THE WAIT CLOSES AS THE BACKLOG DRAINS (S = 1, a 100 ms cell, 40 and 120
+//     fillers: the reviewer's probe, RUN on fc72c786 at 4.11–4.14 s and
+//     12.19–12.22 s for a 44 ms / 132 ms drain — cost × (N+1)/S, frozen).
+//  2. AT BURST SCALE (S = 3, 1,600 fillers, a 275 ms cell: the refresher's
+//     recorded burst and the reviewer's example, whose frozen floor is ~147 s).
+//
+// In both, X's next refresh must start within RefreshCost × max(1, K_now/S) of
+// the drain (K_now ≤ S once drained: one cost), plus scheduling slack — and not
+// before its own floor (start ≥ its last Put + its cost: the coalescing kept).
+// Falsifier: the fixed AddAfter(floor − elapsed) restored ⇒ X waits out the
+// floor frozen at the peak (4.1 s / ~147 s) ⇒ RED. Every bound comes from the
+// arm's own clock and the fake refresh's own measured cost.
+
+package cache
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// liveBacklogArm runs one arm: parallelism p, a cell X costing cost, fillers
+// behind it, and the drain; it asserts X's second refresh against the drain.
+func liveBacklogArm(t *testing.T, p, fillers int, cost, slack time.Duration) {
+	t.Helper()
+	CompleteRBACSnapshotForTest(t)
+	cleanup := withCleanRefresher(t, p, 0)
+	t.Cleanup(cleanup)
+	t.Cleanup(SetRefresherRateFloorForTest("")) // the production rule
+	resetRefresherForTest()
+	c := ResolvedCache()
+	s := max(p-1, 1) // the unviewed side's workers (#1069)
+
+	mk := func(name string) string {
+		in := ResolvedKeyInputs{CacheEntryClass: "widgets", Name: name}
+		k := ComputeKey(in)
+		putAgedEntry(c, k, &in)
+		return k
+	}
+	x := mk("live-backlog-x")
+	gates := make([]string, s)
+	isGate := map[string]bool{}
+	for i := range gates {
+		gates[i] = mk(fmt.Sprintf("live-backlog-gate-%d", i))
+		isGate[gates[i]] = true
+	}
+	fill := make([]string, fillers)
+	for i := range fill {
+		fill[i] = mk(fmt.Sprintf("live-backlog-fill-%d", i))
+	}
+
+	var (
+		mu         sync.Mutex
+		xRuns      []refreshRun
+		xPutAt     []time.Time
+		lastFillAt time.Time
+		fillDone   atomic.Int64
+		gateIn     atomic.Int64
+	)
+	gateCh := make(chan struct{})
+	openGates := sync.OnceFunc(func() { close(gateCh) })
+	t.Cleanup(openGates)
+	RegisterRefreshFunc("widgets", func(ctx context.Context, k string, used ResolvedKeyInputs) error {
+		switch {
+		case k == x:
+			start := time.Now()
+			gen := c.CaptureGen(k)
+			rctx := WithL1KeyContext(ctx, k)
+			time.Sleep(cost)
+			if !c.replaceIfGenRefresh(rctx, k, &ResolvedEntry{RawJSON: []byte(`{}`), Inputs: &used}, gen).Stored() {
+				t.Errorf("terminal Put refused for X")
+			}
+			mu.Lock()
+			xRuns = append(xRuns, refreshRun{start: start, cost: time.Since(start)})
+			xPutAt = append(xPutAt, time.Now())
+			mu.Unlock()
+		case isGate[k]:
+			gateIn.Add(1)
+			<-gateCh // holds an unviewed worker until the backlog is in place
+		default: // a filler: ~1 ms of work, no Put, so it is never floored itself
+			time.Sleep(time.Millisecond)
+			mu.Lock()
+			lastFillAt = time.Now()
+			mu.Unlock()
+			fillDone.Add(1)
+		}
+		return nil
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	StartRefresher(ctx)
+	r := refresherSingleton()
+
+	// X's first refresh records its cost.
+	enqueueRefreshForTest(x)
+	waitFor(t, 5*time.Second, "X's first refresh", func() bool { mu.Lock(); defer mu.Unlock(); return len(xRuns) == 1 })
+	// Every unviewed worker held; X, then the fillers, queued behind them.
+	for _, g := range gates {
+		enqueueRefreshForTest(g)
+	}
+	waitFor(t, 5*time.Second, "every unviewed worker held by a gate", func() bool { return gateIn.Load() == int64(s) })
+	enqueueRefreshForTest(x)
+	for _, f := range fill {
+		enqueueRefreshForTest(f)
+	}
+	floored0 := r.flooredTotal.Load()
+	openGates()
+
+	// SETUP: X is floored at the top of the backlog, while most fillers still
+	// wait (read from the floored counter, which both the set and a frozen
+	// AddAfter tick, so the falsifier passes this SETUP too).
+	var doneAtFloor int64
+	waitFor(t, 5*time.Second, "X floored at the top of the backlog", func() bool {
+		if r.flooredTotal.Load() == floored0 {
+			return false
+		}
+		doneAtFloor = fillDone.Load()
+		return true
+	})
+	mu.Lock()
+	first := xRuns[0]
+	firstPut := xPutAt[0]
+	mu.Unlock()
+	if doneAtFloor > int64(fillers/4) {
+		t.Fatalf("SETUP: %d of %d fillers had already run when X was floored; the arm needs the peak", doneAtFloor, fillers)
+	}
+	kAtFloor := fillers - int(doneAtFloor) // at least: the fillers still queued behind X
+	frozen := time.Duration(int64(first.cost) * int64(kAtFloor) / int64(s))
+
+	waitFor(t, 15*time.Second, fmt.Sprintf("X's second refresh (a floor frozen at the peak holds it ~%v)", frozen),
+		func() bool { mu.Lock(); defer mu.Unlock(); return len(xRuns) == 2 })
+	mu.Lock()
+	second := xRuns[1]
+	drained := lastFillAt
+	mu.Unlock()
+	if n := fillDone.Load(); n != int64(fillers) {
+		t.Fatalf("SETUP: X re-ran before the drain (%d of %d fillers done): the backlog did not hold it", n, fillers)
+	}
+	// The floor still holds: no refresh before the cell is as old as its cost.
+	if age := second.start.Sub(firstPut); age < first.cost-slack {
+		t.Fatalf("X re-ran %v after its last Put, below its own cost %v: the floor did not hold", age, first.cost)
+	}
+	// And it follows the drain: within one cost (K_now ≤ S) of the last filler.
+	bound := first.cost + slack
+	if lag := second.start.Sub(drained); lag > bound {
+		t.Fatalf("X re-ran %v after the backlog drained: want ≤ %v (cost %v × max(1, K_now/S) + %v slack). "+
+			"Its floor was frozen at the peak (K≥%d, S=%d: %v)", lag, bound, first.cost, slack, kAtFloor, s, frozen)
+	}
